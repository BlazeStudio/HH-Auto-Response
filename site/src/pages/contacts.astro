---
import Base from '../layouts/Base.astro';
import ContactTile from '../components/ContactTile.astro';
import Icon from '../components/Icon.astro';
import { contacts, links } from '../config';

const project = [
  { icon: 'bug', tone: 'warn', title: 'Нашли ошибку', action: 'Создать отчёт', href: links.bugReport, text: 'Сначала проверьте, что у вас последняя версия. Убирайте из логов личные данные перед отправкой.' },
  { icon: 'idea', tone: 'ai', title: 'Есть идея', action: 'Предложить', href: links.featureRequest, text: 'Опишите, что хотите получить и зачем. Перед крупной доработкой лучше обсудить её в Issues.' },
  { icon: 'merge', tone: 'hh', title: 'Хотите доработать', action: 'Как это устроено', href: links.contributing, text: 'Сделайте форк и пришлите pull request. Условия приёма вклада описаны в CONTRIBUTING.' },
] as const;
---

<Base
  title="Контакты: HH-Auto-Response"
  description="Как связаться с автором HH-Auto-Response, сообщить об ошибке, предложить идею или договориться о коммерческой лицензии."
  showFooterContact={false}
>
  <div class="wrap soft-in pt-14 pb-[clamp(4.5rem,10vw,7rem)] sm:pt-20">
    <p class="kicker">Контакты</p>
    <h1 class="h1 mt-4 max-w-3xl text-[clamp(2.25rem,5vw,3.5rem)]!">Напишите, если что-то не так</h1>
    <p class="lead mt-6">
      Написать можно мне напрямую, а ошибки и идеи удобнее оставлять на GitHub
    </p>

    <div class="mt-12 grid gap-4 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,1fr)]">
      <div class="card card-hover contact-feature" style="--tone: var(--color-hh)">
        <span class="contact-clip" aria-hidden="true"><Icon name="telegram" class="contact-watermark" /></span>
        <span class="contact-icon contact-icon-lg"><Icon name="telegram" class="size-6" /></span>
        <div class="mt-auto">
          <p class="text-sm text-fg-3">Telegram</p>
          <a class="contact-link contact-link-lg" href={contacts.telegram.url}>{contacts.telegram.label}</a>
          <p class="body-sm mt-2 max-w-sm">Вопросы, идеи, коммерческая лицензия.</p>
          <span class="contact-go">Написать <Icon name="arrow" class="contact-arrow size-4" /></span>
        </div>
      </div>

      <div class="grid gap-4">
        <ContactTile
          icon="mail"
          tone="ai"
          label="Почта"
          value={contacts.email}
          href={`mailto:${contacts.email}`}
          note="Если вопрос длинный или нужны вложения."
          copy={contacts.email}
        />
        <ContactTile
          icon="github"
          tone="ok"
          label="GitHub"
          value={contacts.github.label}
          href={links.repo}
          note="Код, версии и обсуждения."
        />
        <ContactTile
          icon="globe"
          tone="warn"
          label="Мой сайт"
          value={contacts.website.label}
          href={contacts.website.url}
          note="Обо мне и других проектах."
        />
      </div>
    </div>

    <h2 class="h3 mt-16 text-2xl!">Про саму программу</h2>
    <div class="mt-6 grid gap-x-10 gap-y-8 border-t border-line pt-8 md:grid-cols-3">
      {
        project.map((item) => (
          <div style={`--tone: var(--color-${item.tone})`}>
            <p class="flex items-center gap-3 font-medium">
              <span class="contact-icon contact-icon-sm"><Icon name={item.icon} class="size-4" /></span>
              {item.title}
            </p>
            <p class="body-sm mt-3">{item.text}</p>
            <a href={item.href} class="link mt-3 inline-flex items-center gap-1.5 text-[0.9375rem]">
              {item.action} <Icon name="arrow" class="size-3.5" />
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex gap-4 rounded-lg border border-line bg-ink-900 p-6 sm:p-7">
      <Icon name="scale" class="mt-1 size-5 text-fg-3" />
      <div>
        <h2 class="h3">Коммерческое использование</h2>
        <p class="body-sm mt-2 max-w-2xl">
          Для себя программой можно пользоваться бесплатно. Продавать её, встраивать в платные сервисы или использовать в
          работе компании можно только с письменного разрешения. Напишите, что задумали, обсудим.
          Подробности в <a class="link" href={links.license}>лицензии PolyForm Noncommercial</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
