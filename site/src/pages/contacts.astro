---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { contacts, links } from '../config';

const direct = [
  { icon: 'telegram', title: 'Telegram', value: contacts.telegram.label, href: contacts.telegram.url, text: 'Вопросы, идеи, коммерческая лицензия.' },
  { icon: 'mail', title: 'Почта', value: contacts.email, href: `mailto:${contacts.email}`, text: 'Если вопрос длинный или нужны вложения.' },
  { icon: 'globe', title: 'Сайт автора', value: contacts.website.label, href: contacts.website.url, text: 'Кто это написал и какие ещё есть проекты.' },
] as const;

const project = [
  { icon: 'bug', title: 'Нашли ошибку', action: 'Создать отчёт', href: links.bugReport, text: 'Сначала проверьте, что у вас последняя версия. Убирайте из логов личные данные перед отправкой.' },
  { icon: 'idea', title: 'Есть идея', action: 'Предложить', href: links.featureRequest, text: 'Опишите, что хотите получить и зачем. Перед крупной доработкой лучше обсудить её в Issues.' },
  { icon: 'merge', title: 'Хотите доработать', action: 'Как это устроено', href: links.contributing, text: 'Сделайте форк и пришлите pull request. Условия приёма вклада описаны в CONTRIBUTING.' },
] as const;
---

<Base
  title="Контакты: HH-Auto-Response"
  description="Как связаться с автором HH-Auto-Response, сообщить об ошибке, предложить идею или договориться о коммерческой лицензии."
>
  <div class="wrap pt-14 pb-[clamp(4.5rem,10vw,7rem)] sm:pt-20">
    <p class="kicker">Контакты</p>
    <h1 class="h1 mt-4 max-w-3xl text-[clamp(2.25rem,5vw,3.5rem)]!">Программу пишу я. Напишите, если что-то не так</h1>
    <p class="lead mt-6">
      Меня зовут Антон. Написать можно напрямую, а ошибки и идеи удобнее оставлять на GitHub: так их увидят и другие
      пользователи.
    </p>

    <div class="mt-12 grid gap-4 md:grid-cols-3">
      {
        direct.map((item) => (
          <a href={item.href} class="card card-hover gap-3 p-6">
            <Icon name={item.icon} class="size-5 text-hh" />
            <div class="mt-2">
              <p class="text-sm text-fg-3">{item.title}</p>
              <p class="mt-0.5 text-lg font-medium tracking-tight break-words">{item.value}</p>
            </div>
            <p class="body-sm">{item.text}</p>
          </a>
        ))
      }
    </div>

    <h2 class="h3 mt-16 text-2xl!">Про саму программу</h2>
    <div class="mt-6 grid gap-x-10 gap-y-8 border-t border-line pt-8 md:grid-cols-3">
      {
        project.map((item) => (
          <div>
            <p class="flex items-center gap-2.5 font-medium"><Icon name={item.icon} class="size-4.5 text-fg-3" />{item.title}</p>
            <p class="body-sm mt-2">{item.text}</p>
            <a href={item.href} class="link mt-3 inline-flex items-center gap-1.5 text-[0.9375rem]">
              {item.action} <Icon name="arrow" class="size-3.5" />
            </a>
          </div>
        ))
      }
    </div>

    <div class="mt-16 flex gap-4 rounded-2xl border border-line bg-ink-900 p-6 sm:p-7">
      <Icon name="scale" class="mt-1 size-5 text-fg-3" />
      <div>
        <h2 class="h3">Коммерческое использование</h2>
        <p class="body-sm mt-2 max-w-2xl">
          Для себя программой можно пользоваться бесплатно. Продавать её, встраивать в платные сервисы или использовать в
          работе компании можно только с письменного разрешения. Напишите, что задумали, обсудим.
          Подробности в <a class="link" href={links.license}>лицензии PolyForm Noncommercial</a>.
        </p>
      </div>
    </div>
  </div>
</Base>
