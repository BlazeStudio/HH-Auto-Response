---
import Icon from './Icon.astro';
import { contacts, links } from '../config';

const year = new Date().getFullYear();

const columns = [
  {
    title: 'Сайт',
    items: [
      { label: 'Возможности', href: '/#features' },
      { label: 'Анализ резюме', href: '/#analysis' },
      { label: 'Установка', href: '/#install' },
      { label: 'Безопасность', href: '/safety' },
      { label: 'Контакты', href: '/contacts' },
    ],
  },
  {
    title: 'Проект',
    items: [
      { label: 'GitHub', href: links.repo },
      { label: 'Все версии', href: links.releases },
      { label: 'CHANGELOG', href: links.changelog },
      { label: 'Инструкция', href: links.readme },
      { label: 'Лицензия PolyForm Noncommercial', href: links.license },
    ],
  },
  {
    title: 'Связаться',
    items: [
      { label: `Telegram ${contacts.telegram.label}`, href: contacts.telegram.url },
      { label: contacts.email, href: `mailto:${contacts.email}` },
      { label: 'Сообщить об ошибке', href: links.bugReport },
      { label: contacts.website.label, href: contacts.website.url },
    ],
  },
];
---

<footer class="border-t border-line">
  <div class="wrap grid gap-12 py-14 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,2fr)]">
    <div class="max-w-sm">
      <a href="/" class="inline-flex items-center gap-2.5 rounded-lg">
        <img src="/logo.png" width="28" height="28" alt="" class="size-7 rounded-lg" loading="lazy" />
        <span class="font-semibold tracking-tight">HH Auto</span>
      </a>
      <p class="body-sm mt-4">
        Программа для автоматических откликов на hh.ru. Работает на вашем компьютере или своём сервере.
      </p>
    </div>

    <div class="grid gap-10 sm:grid-cols-3">
      {
        columns.map((column) => (
          <div>
            <h2 class="text-sm font-medium text-fg-3">{column.title}</h2>
            <ul class="mt-3 grid gap-2">
              {column.items.map((item) => (
                <li>
                  <a href={item.href} class="text-[0.9375rem] leading-snug text-fg-2 transition-colors hover:text-fg">
                    {item.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>

  <div class="border-t border-line">
    <div class="wrap flex flex-col gap-3 py-6 text-[0.8125rem] leading-relaxed text-fg-3 md:flex-row md:items-start md:justify-between md:gap-10">
      <p>
        © {year} BlazeStudio. Неофициальный проект: он не связан с HeadHunter и не одобрен им.
        За использование программы и соблюдение правил hh.ru отвечает пользователь.
      </p>
      <p class="flex shrink-0 items-center gap-2">
        <Icon name="lock" class="size-3.5" />
        Сайт без cookies и счётчиков
      </p>
    </div>
  </div>
</footer>
