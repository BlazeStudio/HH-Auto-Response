---
import Icon from './Icon.astro';
import { contacts, links, sitePath } from '../config';
---

<section class="pb-[clamp(4.5rem,10vw,7rem)]">
  <div class="wrap">
    <div class="reveal relative isolate overflow-hidden rounded-xl border border-line bg-ink-900 px-6 py-14 sm:px-12 lg:py-20">
      <div
        class="absolute inset-0 -z-10"
        style="background: radial-gradient(40rem 22rem at 90% 110%, color-mix(in srgb, var(--color-ai) var(--glow-strong), transparent), transparent 70%), radial-gradient(36rem 20rem at 0% 110%, color-mix(in srgb, var(--color-hh) var(--glow), transparent), transparent 70%)"
        aria-hidden="true"
      >
      </div>

      <div class="grid gap-10 lg:grid-cols-[minmax(0,1.5fr)_minmax(0,1fr)] lg:items-end lg:gap-16">
        <div>
          <h2 class="h2 mt-0!">
            Займитесь собеседованиями.
            <span class="dim block">Откликами займётся робот.</span>
          </h2>
          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a class="btn btn-primary" href="#install">
              <Icon name="download" />
              Скачать
            </a>
            <a class="btn btn-ghost" href={links.repo}>
              <Icon name="github" />
              Исходный код
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
